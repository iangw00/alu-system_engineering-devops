#!/usr/bin/env bash
# Configures Nginx to run as the nginx user and listen on port 8080
pkill apache2
pkill nginx
sed -i 's/^#\?user .*/user nginx;/' /etc/nginx/nginx.conf
sed -i 's/listen 80\b/listen 8080/; s/listen \[::\]:80\b/listen [::]:8080/' /etc/nginx/sites-enabled/default
chmod 644 /etc/nginx/nginx.conf
su -s /bin/bash nginx -c "service nginx restart"
